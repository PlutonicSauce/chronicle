# Leave DATABASE_URL unset to run Chronicle's polished seeded demo.
# For CockroachDB Cloud, copy the connection string from Connect > General connection string.
DATABASE_URL=

PROJECT_SLUG=atlas
PROJECT_NAME=Atlas
PROJECT_REPOSITORY=acme/atlas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS Bedrock: set true only after configuring AWS credentials and model access.
AWS_REGION=us-east-1
USE_BEDROCK=false
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_TEXT_MODEL=amazon.nova-lite-v1:0
EMBEDDING_DIMENSIONS=512

# Optional: enables POST /api/v1/exports to write a JSON report to this bucket.
S3_EXPORT_BUCKET=
